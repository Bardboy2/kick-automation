# ─────────────────────────────────────────────────────────────────────────────
# kick_automation — Environment Variables
# Copy this file to config/.env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kick ──────────────────────────────────────────────────────────────────────
KICK_CHANNEL_SLUG=yourchannelname          # e.g. "yourname" (the slug in kick.com/yourname)

# ── Claude / Anthropic ────────────────────────────────────────────────────────
# 1. Go to console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Data directories (Mac-friendly paths) ─────────────────────────────────────
# Defaults are set automatically relative to the project root.
# Override here only if you want to store data elsewhere.
# DOWNLOAD_DIR=~/kick_automation/data/downloads
# STATE_FILE=~/kick_automation/data/state/seen_vods.json

# ── Monitor ───────────────────────────────────────────────────────────────────
POLL_INTERVAL=300            # seconds between Kick API polls (default: 5 min)
MAX_DOWNLOADS=3              # max VODs to process per poll cycle

# ── Clip detection ────────────────────────────────────────────────────────────
CLIPS_PER_VOD=3              # max viral clips to extract per VOD
MIN_GAP_SEC=60               # minimum seconds between clips
CLIP_DURATION_SEC=45         # target clip length in seconds (30–60)

# ── Whisper captions ──────────────────────────────────────────────────────────
# Model size: tiny | base | small (recommended) | medium | large
WHISPER_MODEL=small

# ── Web dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=5050          # port for the local review dashboard
FLASK_SECRET_KEY=change-me-to-a-random-string

# ── YouTube Shorts ────────────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → New project → Enable YouTube Data API v3
# 2. Credentials → Create OAuth 2.0 Client ID (Desktop app) → download client_secret.json
#    Save it as config/client_secret.json
# 3. Run once: python scripts/auth_youtube.py   (opens browser, writes refresh token below)
YOUTUBE_CLIENT_ID=xxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxx

# ── TikTok ────────────────────────────────────────────────────────────────────
# 1. Go to developers.tiktok.com → Create app → enable "Content Posting API"
# 2. Run once: python scripts/auth_tiktok.py    (opens browser, writes access token below)
TIKTOK_CLIENT_KEY=xxxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxx
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxx

# ── Instagram / Meta ─────────────────────────────────────────────────────────
# 1. Go to developers.facebook.com → Create app (Business type) → Add Instagram Graph API
# 2. Connect your Instagram Business / Creator account
# 3. Generate a long-lived user token (valid 60 days — set a reminder to refresh)
# 4. Instagram requires a public video URL. Host clips on S3 or any CDN and set the base URL:
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxxxxxx
INSTAGRAM_USER_ID=123456789012345
CLIP_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com/clips

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → copy the token
TELEGRAM_BOT_TOKEN=
# 2. Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=
