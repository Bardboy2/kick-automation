[Unit]
Description=Kick Automation — Caption Editor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kick_automation
EnvironmentFile=/opt/kick_automation/config/.env
Environment=CAPTION_EDITOR_PORT=8888
ExecStart=/opt/kick_automation/.venv/bin/python scripts/caption_editor.py
Restart=always
RestartSec=10

CPUQuota=50%
MemoryMax=512M
Nice=10

StandardOutput=append:/opt/kick_automation/logs/editor.log
StandardError=append:/opt/kick_automation/logs/editor.log

[Install]
WantedBy=multi-user.target
