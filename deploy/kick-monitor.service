[Unit]
Description=Kick Automation — VOD Monitor (Kick + Twitch)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kick_automation
EnvironmentFile=/opt/kick_automation/config/.env
ExecStart=/opt/kick_automation/.venv/bin/python scripts/monitor.py
Restart=always
RestartSec=30

# Keep the poller light — the pipelines it spawns do the heavy lifting
CPUQuota=50%
MemoryMax=512M
Nice=10

StandardOutput=append:/opt/kick_automation/logs/monitor.log
StandardError=append:/opt/kick_automation/logs/monitor.log

[Install]
WantedBy=multi-user.target
